# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Free, instant: fred.stlouisfed.org -> My Account -> API Keys -> Request API Key.
# Used by C4's inflation-adjusted limit comparison (api/audit.py). Without it the
# audit still runs, but against a pinned CPI snapshot rather than a live figure,
# and every result says so via cpi.source == "fallback".
FRED_API_KEY=

# Optional overrides — sensible defaults are baked in, set these only to change them.
# CPI_SERIES_ID=CPIAUCSL
# SPREADSHEET_ID=1avXBzepTNQXcjl4aHW7ocdLBk5KooPVMw0U1I2uZRoE
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
