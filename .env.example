# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Nothing here is required. The audit engine's inflation source (the World Bank's
# global consumer-price series) needs no API key and no signup, so a fresh clone
# runs with no .env file at all.

# Optional overrides — sensible defaults are baked in.
# SPREADSHEET_ID=1avXBzepTNQXcjl4aHW7ocdLBk5KooPVMw0U1I2uZRoE
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
