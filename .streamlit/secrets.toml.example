# Copy this file to secrets.toml (same folder) and fill in the real values.
# secrets.toml is gitignored — never commit real credentials.
#
# IMPORTANT: after creating the service account, open the Google Sheet, click
# Share, and add the service account's client_email (below) as an Editor.
# "Anyone with the link can edit" does NOT cover API access — the service
# account needs to be listed explicitly.
#
# spreadsheet_id is the long ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
spreadsheet_id = "1avXBzepTNQXcjl4aHW7ocdLBk5KooPVMw0U1I2uZRoE"

# Paste every field from the service account JSON key you downloaded in
# Google Cloud Console (APIs & Services > Credentials > your service account
# > Keys > Add Key > JSON). Field names below match the JSON key exactly.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR KEY HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "your-client-cert-url"
